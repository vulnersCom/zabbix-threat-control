# Copy to ztc.env and fill in. Used by compose.prod.yml (env_file).

# --- Vulners ---
VULNERS_API_KEY=
# Optional: self-hosted / proxy Vulners endpoint (default: https://vulners.com)
# VULNERS_BASE_URL=https://vulners.com

# --- Zabbix API (frontend / JSON-RPC) ---
ZABBIX_URL=http://zabbix-web:8080
# Authentication — use an API token (preferred, Zabbix 7.x) OR user+password:
ZABBIX_TOKEN=
# ZABBIX_USER=Admin
# ZABBIX_PASSWORD=zabbix

# --- zabbix-sender target (Zabbix server or proxy) ---
ZABBIX_SERVER_FQDN=zabbix-server
ZABBIX_SERVER_PORT=10051

# --- scanner ---
ZTC_SCHEDULE=1h
# ZTC_LOG_LEVEL=info
