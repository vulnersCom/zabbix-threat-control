# Copy to ztc.env and fill in. Used by compose.prod.yml (env_file).

# --- Vulners ---
VULNERS_API_KEY=
# Optional: self-hosted / proxy Vulners endpoint (default: https://vulners.com)
# VULNERS_BASE_URL=https://vulners.com

# --- Zabbix API (frontend / JSON-RPC) ---
ZABBIX_URL=http://zabbix-web:8080
# Authentication — use an API token (preferred, Zabbix 7.x) OR user+password:
ZABBIX_TOKEN=
# ZABBIX_USER=Admin
# ZABBIX_PASSWORD=zabbix

# --- zabbix-sender target (Zabbix server or proxy) ---
ZABBIX_SERVER_FQDN=zabbix-server
ZABBIX_SERVER_PORT=10051

# --- scanner ---
ZTC_SCHEDULE=1h
# ZTC_LOG_LEVEL=info
# Comma-separated Zabbix usernames allowed to authorise --auto-fix by
# acknowledging a problem (required for auto-remediation via the installer):
# ZTC_TRUSTED_USERS=Admin
# Drop findings below this CVSS before creating any Zabbix object. This is the
# main lever on object count (each kept (vuln, host) pair = 1 item + 1 trigger);
# raise it to 7 if provisioning strains the server's CacheSize. Default 1.
# ZTC_MIN_CVSS=1
# "Allowed hosts" on the trapper items provision creates. Unset = accept from
# any host; set it to the address ztc pushes from to narrow that down.
# ZABBIX_TRAPPER_HOSTS=
