# Copy to .env and fill in. Only VULNERS_API_KEY is required.
VULNERS_API_KEY=
# Optional: point at a proxy / self-hosted Vulners endpoint.
VULNERS_BASE_URL=
# Optional: drop findings below this CVSS before creating Zabbix objects. Raise it
# (e.g. 7) if the stand's Zabbix server starts warning about CacheSize.
ZTC_MIN_CVSS=1
